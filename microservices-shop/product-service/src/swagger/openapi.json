{
  "openapi": "3.0.3",
  "info": {
    "title": "Lab2a Product Service",
    "version": "1.0.0",
    "description": "PostgreSQL + Prisma. PUT requires name and price. DELETE is soft delete."
  },
  "servers": [
    {
      "url": "/",
      "description": "Direct service (same host)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Gateway"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ProductInput": {
        "type": "object",
        "required": [
          "name",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "example": "Bàn phím cơ"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 99999999.99,
            "example": 700000
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "example": 20
          },
          "description": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "categoryId": {
            "type": "integer",
            "nullable": true,
            "minimum": 1
          }
        },
        "example": {
          "name": "Bàn phím cơ",
          "price": 700000,
          "stock": 20,
          "description": "Bàn phím cơ dùng để kiểm thử API"
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "example": "Bàn phím cơ"
          },
          "price": {
            "type": "string",
            "description": "Prisma Decimal serializes as a JSON string",
            "example": "700000"
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "example": 20
          },
          "description": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "categoryId": {
            "type": "integer",
            "nullable": true
          },
          "id": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
