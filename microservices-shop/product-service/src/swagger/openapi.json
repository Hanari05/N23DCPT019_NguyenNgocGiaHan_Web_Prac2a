                }
              }
            }
          },
          "503": {
            "description": "Service phụ thuộc không khả dụng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
