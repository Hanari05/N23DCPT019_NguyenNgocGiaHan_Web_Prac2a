{
  "openapi": "3.0.3",
  "info": {
    "title": "Lab2a Order Service",
    "version": "1.0.0",
    "description": "MongoDB + Mongoose. JWT authentication and order ownership are enforced. Product prices are fetched from Product Service."
  },
  "servers": [
    {
      "url": "/",
      "description": "Direct service (same host)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Gateway"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "OrderInput": {
        "type": "object",
        "required": [
          "customerName",
          "customerEmail",
          "items"
        ],
        "properties": {
          "customerId": {
            "type": "integer",
            "minimum": 1,
            "example": 1,
            "description": "ID user trong JWT; server tự gán khi tạo đơn."
          },
          "customerName": {
            "type": "string",
            "example": "Nguyễn Ngọc Gia Hân"
          },
          "customerEmail": {
            "type": "string",
            "format": "email",
            "example": "han@example.com"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "productId",
                "quantity"
              ],
              "properties": {
                "productId": {
                  "type": "integer",
                  "example": 1
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "example": 2
                }
              }
            }
          },
          "shippingAddress": {
            "type": "object",
            "properties": {
              "street": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "district": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "minimum": 1,
            "example": 1,
            "description": "ID user trong JWT; server tự gán khi tạo đơn."
          },
          "customerName": {
            "type": "string",
            "example": "Nguyễn Ngọc Gia Hân"
          },
          "customerEmail": {
            "type": "string",
            "format": "email",
            "example": "han@example.com"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "integer"
                },
                "productName": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                },
                "quantity": {
                  "type": "integer"
                },
                "subtotal": {
                  "type": "number"
                }
              }
            }
          },
          "shippingAddress": {
            "type": "object",
            "properties": {
              "street": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "district": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": "string"
          },
          "_id": {
            "type": "string"
          },
          "orderCode": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "shipping",
              "delivered",
              "cancelled"
            ]
          },
          "totalAmount": {
            "type": "number"
          },
          "totalItems": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
