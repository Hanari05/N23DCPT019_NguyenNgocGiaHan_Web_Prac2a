{
  "info": {
    "name": "Lab2a Microservices + Demo Docker",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection v2.1. Giữ nguyên Core flow và Auth TODO, bổ sung thư mục Demo Docker gồm POST/PATCH/DELETE. base_url=http://localhost:3000. Chạy riêng thư mục Demo Docker để đối chiếu database; demoOrderId tự lưu sau POST. Không chạy Auth TODO khi chưa triển khai Auth Service."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "demoProductId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "demoOrderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Demo Docker - POST PATCH DELETE",
      "description": "Chạy lần lượt 01 → 02 → 03. Sau mỗi request, đối chiếu bản ghi trong MongoDB orders_db.orders. demoProductId phải là sản phẩm đang hoạt động, tồn kho ít nhất 2. demoOrderId tự lưu sau POST.",
      "item": [
        {
          "name": "01 - POST tạo đơn để đối chiếu MongoDB",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"customerName\": \"Nguyễn Ngọc Gia Hân\",\n  \"customerEmail\": \"han@example.com\",\n  \"items\": [\n    {\n      \"productId\": {{demoProductId}},\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"demoOrderId\", \"\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const order = pm.response.json().data;",
                  "  pm.test(\"Order ID hợp lệ\", () => pm.expect(order._id).to.match(/^[a-f0-9]{24}$/i));",
                  "  pm.collectionVariables.set(\"demoOrderId\", order._id);",
                  "  pm.test(\"Trạng thái ban đầu pending\", () => pm.expect(order.status).to.eql(\"pending\"));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - PATCH xác nhận đơn",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/orders/{{demoOrderId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!/^[a-f0-9]{24}$/i.test(String(pm.variables.get(\"demoOrderId\") || \"\"))) {",
                  "  console.error(\"Hãy chạy POST tạo đơn thành công trước.\");",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status changed',()=>pm.expect(pm.response.json().data.status).to.eql('confirmed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - DELETE xóa đơn",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/orders/{{demoOrderId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!/^[a-f0-9]{24}$/i.test(String(pm.variables.get(\"demoOrderId\") || \"\"))) {",
                  "  console.error(\"Hãy chạy POST tạo đơn thành công trước.\");",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
